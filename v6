<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dokumentarkivet – Skyggekongens Kammer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;900&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #080606;
            color: #c8a96e;
            font-family: 'EB Garamond', Georgia, 'Times New Roman', serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Subtle noise texture overlay */
        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            opacity: 0.4;
        }

        /* =========== HEADER =========== */
        header {
            text-align: center;
            padding: 3.5rem 2rem 2.5rem;
            border-bottom: 1px solid #2a1a0a;
            position: relative;
            z-index: 1;
        }

        header::after {
            content: '';
            position: absolute;
            bottom: 0; left: 10%; right: 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, #5a3a18, transparent);
        }

        .candles {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 4rem;
            margin-bottom: 2rem;
        }

        .candle {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .flame {
            width: 14px;
            height: 22px;
            background: radial-gradient(ellipse at 50% 80%, #fff7a0 0%, #ffb700 30%, #ff6a00 65%, transparent 100%);
            border-radius: 50% 50% 30% 30%;
            animation: flicker 2s ease-in-out infinite alternate;
            filter: blur(0.5px);
            box-shadow: 0 0 8px 2px rgba(255, 160, 20, 0.4);
        }

        .candle:nth-child(2) .flame { animation-delay: 0.4s; animation-duration: 1.8s; }
        .candle:nth-child(3) .flame { animation-delay: 0.8s; animation-duration: 2.3s; }

        @keyframes flicker {
            0%   { transform: scaleY(1)    scaleX(1)    rotate(-1deg); opacity: 0.9; }
            20%  { transform: scaleY(1.08) scaleX(0.93) rotate(1deg);  opacity: 1;   }
            40%  { transform: scaleY(0.95) scaleX(1.04) rotate(-0.5deg); opacity: 0.88; }
            60%  { transform: scaleY(1.05) scaleX(0.97) rotate(1.5deg); opacity: 0.95; }
            80%  { transform: scaleY(0.98) scaleX(1.02) rotate(-1deg); opacity: 0.92; }
            100% { transform: scaleY(1.12) scaleX(0.91) rotate(0.5deg); opacity: 1; }
        }

        .candle-body {
            width: 14px;
            height: 50px;
            background: linear-gradient(180deg, #d4c4a0 0%, #b8a880 100%);
            border-radius: 2px 2px 0 0;
            margin-top: -2px;
            box-shadow: inset -3px 0 6px rgba(0,0,0,0.2);
        }

        .candle:nth-child(2) .candle-body { height: 70px; }

        .title-eyebrow {
            font-family: 'Cinzel', 'Palatino Linotype', serif;
            font-size: 0.78rem;
            letter-spacing: 0.42em;
            color: #b08a4a;
            margin-bottom: 0.8rem;
        
            text-shadow: 0 0 10px rgba(200, 160, 80, 0.14);}

        .title-main {
            font-family: 'Cinzel', 'Palatino Linotype', serif;
            font-size: clamp(1.8rem, 5vw, 3rem);
            font-weight: 900;
            color: #e8c87a;
            text-shadow:
                0 0 40px rgba(200, 100, 20, 0.4),
                0 0 80px rgba(200, 60, 10, 0.2);
            letter-spacing: 0.12em;
            line-height: 1.1;
        }

        .title-sub {
            font-family: 'Cinzel', 'Palatino Linotype', serif;
            font-size: 0.82rem;
            color: #a8845a;
            letter-spacing: 0.30em;
            margin-top: 0.7rem;
        
            text-shadow: 0 0 10px rgba(200, 160, 80, 0.12);}

        .ornament {
            color: #4a3018;
            letter-spacing: 0.5em;
            font-size: 1rem;
            margin-top: 1.2rem;
        }

        /* =========== INTRO =========== */
        .intro {
            max-width: 640px;
            margin: 2.5rem auto;
            padding: 0 2rem;
            text-align: center;
            font-style: italic;
            color: #b08a55;
            font-size: 1.05rem;
            line-height: 1.8;
            position: relative;
            z-index: 1;
        }

        /* =========== ARCHIVE GRID =========== */
        .archive-label {
            text-align: center;
            font-family: 'Cinzel', serif;
            font-size: 0.72rem;
            letter-spacing: 0.42em;
            color: #8a6a3a;
            margin: 0 auto 1.5rem;
            position: relative;
            z-index: 1;
        
            text-shadow: 0 0 10px rgba(200, 160, 80, 0.10);}

        /* =========== SEARCH =========== */
        .search-wrap {
            max-width: 720px;
            margin: 0 auto 2rem;
            padding: 0 2rem;
            position: relative;
            z-index: 1;
        }

        .search-input {
            width: 100%;
            background: linear-gradient(145deg, #14100a 0%, #1c1408 60%, #12100a 100%);
            border: 1px solid #2e1e0e;
            color: #c8a96e;
            padding: 0.95rem 1.05rem;
            font-family: 'EB Garamond', Georgia, 'Times New Roman', serif;
            font-size: 1rem;
            letter-spacing: 0.02em;
            outline: none;
            box-shadow: inset 0 0 18px rgba(0,0,0,0.35);
        }

        .search-input::placeholder {
            color: #5a4020;
            font-style: italic;
        }

        .search-hint {
            margin-top: 0.75rem;
            text-align: center;
            font-size: 0.8rem;
            color: #2a1a08;
            letter-spacing: 0.3em;
        }

        .search-count {
            color: #4a3018;
        }

        .archive {
            max-width: 1100px;
            margin: 0 auto 4rem;
            padding: 0 2rem;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 1.8rem;
            position: relative;
            z-index: 1;
        }

        /* =========== DOCUMENT CARDS =========== */
        .doc-card {
            background: linear-gradient(145deg, #14100a 0%, #1c1408 60%, #12100a 100%);
            border: 1px solid #2e1e0e;
            padding: 1.8rem;
            cursor: pointer;
            transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
            position: relative;
            overflow: hidden;
        }

        /* Corner ornaments */
        .doc-card::before,
        .doc-card::after {
            content: '';
            position: absolute;
            width: 12px;
            height: 12px;
            border-color: #3a2510;
            border-style: solid;
        }

        .doc-card::before {
            top: 8px; left: 8px;
            border-width: 1px 0 0 1px;
        }

        .doc-card::after {
            bottom: 8px; right: 8px;
            border-width: 0 1px 1px 0;
        }

        .doc-card:hover {
            border-color: #5a3a18;
            transform: translateY(-3px);
            box-shadow:
                0 10px 30px rgba(0,0,0,0.6),
                0 0 20px rgba(120, 60, 10, 0.08);
        }

        .doc-icon {
            font-size: 1.6rem;
            margin-bottom: 0.9rem;
            display: block;
            filter: grayscale(0.3);
        }

        .doc-title {
            font-family: 'Cinzel', 'Palatino Linotype', serif;
            font-size: 0.88rem;
            color: #c8a060;
            margin-bottom: 0.7rem;
            letter-spacing: 0.04em;
            line-height: 1.4;
        }

        .doc-preview {
            font-size: 0.88rem;
            color: #7a5a33;
            line-height: 1.65;
            font-style: italic;
        }

        .doc-meta {
            margin-top: 1.2rem;
            padding-top: 0.8rem;
            border-top: 1px solid #1e1408;
            font-size: 0.72rem;
            color: #6a5030;
            letter-spacing: 0.08em;
        }

        .doc-badge {
            display: inline-block;
            font-size: 0.65rem;
            letter-spacing: 0.15em;
            color: #4a3015;
            border: 1px solid #2e1e0a;
            padding: 0.15rem 0.4rem;
            margin-bottom: 0.5rem;
        }

        /* =========== MODAL =========== */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.88);
            z-index: 200;
            justify-content: center;
            align-items: flex-start;
            padding: 3rem 1.5rem;
            overflow-y: auto;
            backdrop-filter: blur(2px);
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background: linear-gradient(170deg, #1a1208 0%, #120e06 50%, #0e0a04 100%);
            border: 1px solid #4a3018;
            max-width: 700px;
            width: 100%;
            margin: auto;
            padding: 3.5rem 3.5rem 3rem;
            position: relative;
            box-shadow:
                0 0 80px rgba(0, 0, 0, 0.9),
                inset 0 0 40px rgba(0, 0, 0, 0.4),
                0 0 30px rgba(100, 50, 10, 0.08);
            animation: modalIn 0.25s ease;
        }

        @keyframes modalIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Double border effect */
        .modal::before {
            content: '';
            position: absolute;
            inset: 10px;
            border: 1px solid #1e1208;
            pointer-events: none;
        }

        .modal-close {
            position: absolute;
            top: 1.2rem;
            right: 1.5rem;
            background: none;
            border: none;
            color: #4a3018;
            font-size: 1.2rem;
            cursor: pointer;
            font-family: 'Cinzel', serif;
            transition: color 0.2s;
            line-height: 1;
        }

        .modal-close:hover {
            color: #c8a060;
        }

        .modal-doc-badge {
            display: block;
            text-align: center;
            font-size: 0.65rem;
            letter-spacing: 0.4em;
            color: #4a3018;
            margin-bottom: 1rem;
        }

        .modal-title {
            font-family: 'Cinzel', 'Palatino Linotype', serif;
            font-size: 1.2rem;
            color: #e0c070;
            text-align: center;
            margin-bottom: 0.3rem;
            letter-spacing: 0.08em;
            line-height: 1.3;
        }

        .modal-divider {
            text-align: center;
            color: #3a2510;
            margin: 1rem 0 1.8rem;
            letter-spacing: 0.6em;
            font-size: 0.75rem;
        }

        .modal-content {
            font-size: 1rem;
            line-height: 1.9;
            color: #c1a078;
        }

        .modal-content p {
            margin-bottom: 1.1rem;
        }

        .modal-content p:last-child {
            margin-bottom: 0;
        }

        .modal-content em {
            color: #c8a060;
            font-style: italic;
        }

        .modal-content .highlight {
            color: #d4aa50;
            font-style: italic;
        }

        .modal-content .scratched {
            text-decoration: line-through;
            opacity: 0.45;
        }

        .modal-content .marginnote {
            font-size: 0.88rem;
            color: #6a5030;
            font-style: italic;
            border-left: 2px solid #2a1a08;
            padding: 0.6rem 0 0.6rem 1.2rem;
            margin: 1.3rem 0;
            line-height: 1.7;
        }

        .modal-content .inscription {
            text-align: center;
            font-style: italic;
            margin: 1.5rem 0;
            color: #c0944a;
            line-height: 2.1;
            letter-spacing: 0.03em;
        }

        .modal-content .centered {
            text-align: center;
        }

        /* =========== FOOTER =========== */
        footer {
            text-align: center;
            padding: 2.5rem 2rem;
            color: #6a5030;
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            border-top: 1px solid #150f06;
            position: relative;
            z-index: 1;
        
            text-shadow: 0 0 10px rgba(200, 160, 80, 0.08);}

        /* =========== RESPONSIVE =========== */
        @media (max-width: 600px) {
            .modal {
                padding: 2.5rem 1.8rem 2rem;
            }

            .candles {
                gap: 2.5rem;
            }
        }
    
        /* =========== SHELVES / DRAWERS =========== */
        .shelf-nav{
            max-width: 980px;
            margin: 0.5rem auto 1.25rem;
            padding: 0 2rem;
            display: flex;
            gap: 0.6rem;
            justify-content: center;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }
        .shelf-tab{
            appearance:none;
            background: linear-gradient(145deg, #151008 0%, #1c1408 60%, #120f09 100%);
            border: 1px solid #2e1e0e;
            color: #c8a96e;
            font-family: 'Cinzel', serif;
            font-size: 0.72rem;
            letter-spacing: 0.22em;
            padding: 0.55rem 0.85rem;
            cursor:pointer;
            transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
            box-shadow: inset 0 0 16px rgba(0,0,0,0.35);
        }
        .shelf-tab:hover{
            transform: translateY(-1px);
            border-color:#5a3a18;
        }
        .shelf-tab.active{
            border-color:#b08a4a;
            box-shadow: 0 0 0 1px rgba(176,138,74,0.25), inset 0 0 16px rgba(0,0,0,0.35);
        }
        .shelf-panels{
            max-width: 1100px;
            margin: 0 auto 2.5rem;
            padding: 0 2rem 2rem;
            position: relative;
            z-index: 1;
        }
        .shelf-panel{ display:none; }
        .shelf-panel.active{ display:block; }

        .drawer-grid{
            display:grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 0.8rem;
            margin-top: 0.6rem;
        }
        .drawer{
            position:relative;
            border: 1px solid #2a1a0a;
            background: radial-gradient(circle at 35% 30%, rgba(255,200,120,0.06), transparent 55%),
                        linear-gradient(145deg, #0f0c08 0%, #15100a 65%, #0b0906 100%);
            padding: 0.75rem 0.75rem 0.65rem;
            min-height: 86px;
            box-shadow: inset 0 0 18px rgba(0,0,0,0.45);
        }
        .drawer.occupied{
            cursor:pointer;
            border-color:#3a240f;
        }
        .drawer.occupied:hover{
            border-color:#b08a4a;
            box-shadow: 0 0 0 1px rgba(176,138,74,0.20), inset 0 0 18px rgba(0,0,0,0.45);
        }
        .drawer.empty{
            opacity:0.65;
        }
        .drawer-number{
            position:absolute;
            top: 0.4rem;
            right: 0.55rem;
            font-family:'Cinzel', serif;
            font-size:0.7rem;
            letter-spacing:0.22em;
            color:#7a5a2f;
        }
        .drawer-icon{
            display:inline-block;
            font-size: 1.1rem;
            margin-bottom: 0.35rem;
            opacity:0.95;
        }
        .drawer-label{
            display:block;
            font-weight: 700;
            font-size: 0.95rem;
            line-height: 1.15;
            color:#e0c27a;
            margin-bottom: 0.35rem;
        }
        .drawer-loc{
            display:block;
            font-family:'Cinzel', serif;
            font-size:0.66rem;
            letter-spacing:0.22em;
            color:#b08a4a;
            opacity:0.9;
        }
        .drawer.flash{
            animation: flash 1.2s ease-in-out 1;
            border-color:#e8c87a !important;
            box-shadow: 0 0 0 1px rgba(232,200,122,0.35), 0 0 28px rgba(232,200,122,0.18), inset 0 0 18px rgba(0,0,0,0.45);
        }
        @keyframes flash{
            0%{ transform: scale(1); }
            40%{ transform: scale(1.02); }
            100%{ transform: scale(1); }
        }

        /* =========== CATALOG =========== */
        .catalog-wrap{
            border: 1px solid #2a1a0a;
            background: linear-gradient(145deg, rgba(15,12,8,0.75), rgba(12,10,7,0.55));
            box-shadow: inset 0 0 22px rgba(0,0,0,0.45);
            padding: 1rem 1rem 1.25rem;
        }
        .catalog-head{
            text-align:center;
            padding: 0.75rem 0.5rem 1rem;
            border-bottom: 1px solid #2a1a0a;
            margin-bottom: 0.9rem;
        }
        .catalog-title{
            font-family:'Cinzel', serif;
            letter-spacing:0.32em;
            font-size:0.78rem;
            color:#e0c27a;
            margin-bottom:0.35rem;
        }
        .catalog-sub{
            font-family:'Cinzel', serif;
            letter-spacing:0.26em;
            font-size:0.62rem;
            color:#b08a4a;
            opacity:0.85;
        }
        .catalog-shelf-title{
            font-family:'Cinzel', serif;
            letter-spacing:0.30em;
            font-size:0.68rem;
            color:#e0c27a;
            margin: 0.85rem 0 0.4rem;
            opacity:0.95;
        }
        .catalog-row{
            display:flex;
            gap: 0.8rem;
            padding: 0.6rem 0.55rem;
            border: 1px solid #241608;
            background: rgba(10,8,6,0.35);
            cursor:pointer;
            margin-bottom: 0.45rem;
        }
        .catalog-row:hover{
            border-color:#b08a4a;
            background: rgba(10,8,6,0.45);
        }
        .catalog-loc{
            flex:0 0 auto;
            font-family:'Cinzel', serif;
            font-size:0.66rem;
            letter-spacing:0.22em;
            color:#b08a4a;
            padding-top:0.1rem;
            min-width: 70px;
        }
        .catalog-main{
            flex:1 1 auto;
            min-width: 0;
        }
        .catalog-docline{
            display:flex;
            flex-wrap:wrap;
            gap: 0.5rem;
            align-items: baseline;
        }
        .catalog-badge{
            font-family:'Cinzel', serif;
            font-size:0.6rem;
            letter-spacing:0.22em;
            color:#8a6a3a;
            opacity:0.95;
        }
        .catalog-doctitle{
            font-weight:700;
            color:#e0c27a;
            font-size:0.88rem;
        }
        .catalog-meta{
            margin-top:0.25rem;
            font-size:0.82rem;
            color:#d2bb86;
            opacity:0.85;
        }
        .catalog-empty{
            font-size:0.8rem;
            color:#8a6a3a;
            opacity:0.7;
            padding:0.4rem 0.2rem 0.6rem;
        }

        @media (max-width: 900px){
            .drawer-grid{ grid-template-columns: repeat(4, 1fr); }
        }
        @media (max-width: 560px){
            .drawer-grid{ grid-template-columns: repeat(2, 1fr); }
        }

    </style>
</head>
<body>

<header>
    <div class="candles">
        <div class="candle">
            <div class="flame"></div>
            <div class="candle-body"></div>
        </div>
        <div class="candle">
            <div class="flame"></div>
            <div class="candle-body"></div>
        </div>
        <div class="candle">
            <div class="flame"></div>
            <div class="candle-body"></div>
        </div>
    </div>

    <p class="title-eyebrow">FUNNE FRAGMENTER · SKYGGEKONGENS KAMMER</p>
    <h1 class="title-main">DOKUMENTARKIVET</h1>
    <p class="title-sub">KATALOGISERT AV UKJENT HÅND · DATO UKJENT</p>
    <p class="ornament">⸻ ✦ ⸻</p>
</header>

<p class="intro">
    Disse dokumentene ble funnet i det forseglede kammeret. Noen er svidd langs kantene.
    Noen er fuktskadde. Alle er ufullstendige. Alle er merket av Skyggekongens magi.
    Les dem med forsiktighet.
</p>

<p class="archive-label">— ARKIVERTE FUNN —</p>

<div class="search-wrap">
    <input id="search" class="search-input" type="search" placeholder="Søk i arkivet… (tittel, utdrag, metadata, tekst)" autocomplete="off" />
    <div class="search-hint">
        VISER <span class="search-count" id="search-count">0</span> AV <span class="search-count" id="search-total">0</span>
    </div>
</div>

<div class="shelf-nav" id="shelf-nav"></div>
<div class="shelf-panels" id="shelf-panels"></div>

<!-- Modal -->
<div class="modal-overlay" id="modal-overlay">
    <div class="modal" id="modal">
        <button class="modal-close" id="modal-close" aria-label="Lukk">✕</button>
        <span class="modal-doc-badge" id="modal-badge"></span>
        <h2 class="modal-title" id="modal-title"></h2>
        <div class="modal-divider">⸻ ✦ ⸻</div>
        <div class="modal-content" id="modal-content"></div>
    </div>
</div>

<footer>
    ARKIVET ER IKKE KOMPLETT &nbsp;·&nbsp; NOEN SANNHETER BRENNER BARE I ILDEN
</footer>

<script>
    
    const documents = [
        {
            id: 'aldor_roim',
            icon: '📜',
            badge: 'OVERSATT FRAGMENT · ROIM-ARKIV',
            title: 'Aldors notat til et gammelt seglskrift',
            preview: 'En rolig hånd har forsøkt å rydde i et språk som ikke vil la seg temme...',
            meta: 'Funnet: I en lærmappe · Tilstand: Godt bevart, med randkommentarer',
            content: `
                <p><em>Oversettelse, med kommentarer i margen.</em></p>
                <p>I gamle segltekster skiller man mellom <em>synfarge</em> og <em>sannfarge</em>.
                Synfargen er den som tilfredsstiller øyet; sannfargen er den som tilfredsstiller ilden.</p>
                <p>Det som ser likt ut i hånden kan oppføre seg ulikt i flammen, og det som ser fremmed ut kan vise seg velkjent.
                Derfor er det et tegn på uerfarenhet å ordne ingredienser etter utseende.</p>
